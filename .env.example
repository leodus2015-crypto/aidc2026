# MySQL（云服务器或 Docker 本地实例）
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=aidc

# 保存配置、页面管理解锁和 status 观测所需 Bearer Token（必填；未设置时管理接口返回 503）
# 仅在服务端配置强随机值，不得写入前端配置、仓库或 URL
ADMIN_TOKEN=

# Nginx 访问日志（访问观测解析脚本）
# 宝塔常见：/www/wwwlogs/aidc2026.cn.log
ANALYTICS_LOG=

# API 服务
API_HOST=127.0.0.1
API_PORT=8012

# 本地静态预览 8011 跨域
CORS_ORIGINS=http://127.0.0.1:8011,http://localhost:8011,https://www.aidc2026.cn,https://aidc2026.cn
