# 复制为 deploy.env 后填写（deploy.env 已在 .gitignore，勿提交）
# cp deploy.env.example deploy.env

# 云服务器 SSH（端口 22，不是 FTP 2332）
DEPLOY_HOST=111.229.190.87
DEPLOY_PORT=22
DEPLOY_USER=root

# 网站根目录（Nginx root）
DEPLOY_PATH=/www/wwwroot/aidc2026.cn

# 本机 SSH 私钥路径（建议为部署专用密钥，见下方说明）
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# 同步后改属主（宝塔常见 www:www）
DEPLOY_OWNER=www:www

# rsync 额外排除（逗号分隔，可选）
# DEPLOY_EXTRA_EXCLUDES=.user.ini
