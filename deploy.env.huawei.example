# 华为云冷备（阶段 1）— 复制为 deploy.env.huawei 后填写（已在 .gitignore，勿提交）
# cp deploy.env.huawei.example deploy.env.huawei
#
# ECS 创建并完成 Nginx 静态目录、备案接入后再填。与 deploy.env（腾讯）并列使用。

# 华为云 ECS 公网 IP 或弹性 IP
HUAWEI_DEPLOY_HOST=

# SSH（默认 22；安全组需放行你的办公 IP）
HUAWEI_DEPLOY_PORT=22
HUAWEI_DEPLOY_USER=root

# 网站根目录（与腾讯 DEPLOY_PATH 保持一致，便于同一套 Nginx 规则）
HUAWEI_DEPLOY_PATH=/www/wwwroot/aidc2026.cn

HUAWEI_DEPLOY_SSH_KEY=~/.ssh/id_ed25519_huawei
HUAWEI_DEPLOY_OWNER=www:www

# 阶段 1：静态冷备。设为 1 时 ./scripts/deploy.sh 在腾讯同步后会 rsync 华为（需本文件存在且 HOST 已填）
# HUAWEI_SYNC=1

# 部署后校验用的公网 URL（填 https://华为临时域名 或 备用域名；未接 DNS 前可留空）
# HUAWEI_SITE_URL=https://
